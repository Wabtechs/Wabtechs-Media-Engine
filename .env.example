# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/media_engine

# Redis
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_BUCKET=media-engine
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_REGION=us-east-1

# CDN
CDN_BASE_URL=http://localhost:9000/media-engine

# Security
API_KEY_SALT=wabtechs-media-engine-salt-change-in-production
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Background Removal
BACKGROUND_REMOVAL_PROVIDER=local

# Processing
IMAGE_PROCESSING_CONCURRENCY=4
WORKER_CONCURRENCY=2
